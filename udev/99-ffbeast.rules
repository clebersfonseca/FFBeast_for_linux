# FFBeast Hardware Udev Rules for Linux
# Grants non-root user access to FFBeast HIDRAW, USB and Input devices.

# FFBeast Wheel (VID: 045b, PID: 59d7)
KERNEL=="hidraw*", ATTRS{idVendor}=="045b", ATTRS{idProduct}=="59d7", MODE="0666", TAG+="uaccess", GROUP="input"
SUBSYSTEM=="usb", ATTRS{idVendor}=="045b", ATTRS{idProduct}=="59d7", MODE="0666", TAG+="uaccess", GROUP="input"
SUBSYSTEM=="input", ATTRS{idVendor}=="045b", ATTRS{idProduct}=="59d7", MODE="0666", TAG+="uaccess", GROUP="input"

# FFBeast Joystick / Flight Controls (VID: 045b, PID: 5968)
KERNEL=="hidraw*", ATTRS{idVendor}=="045b", ATTRS{idProduct}=="5968", MODE="0666", TAG+="uaccess", GROUP="input"
SUBSYSTEM=="usb", ATTRS{idVendor}=="045b", ATTRS{idProduct}=="5968", MODE="0666", TAG+="uaccess", GROUP="input"
SUBSYSTEM=="input", ATTRS{idVendor}=="045b", ATTRS{idProduct}=="5968", MODE="0666", TAG+="uaccess", GROUP="input"

# FFBeast Rudder Pedals (VID: 045b, PID: 58f9)
KERNEL=="hidraw*", ATTRS{idVendor}=="045b", ATTRS{idProduct}=="58f9", MODE="0666", TAG+="uaccess", GROUP="input"
SUBSYSTEM=="usb", ATTRS{idVendor}=="045b", ATTRS{idProduct}=="58f9", MODE="0666", TAG+="uaccess", GROUP="input"
SUBSYSTEM=="input", ATTRS{idVendor}=="045b", ATTRS{idProduct}=="58f9", MODE="0666", TAG+="uaccess", GROUP="input"

# STM32 DFU Bootloader Mode (VID: 0483, PID: df11)
SUBSYSTEM=="usb", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="df11", MODE="0666", TAG+="uaccess", GROUP="plugdev"
